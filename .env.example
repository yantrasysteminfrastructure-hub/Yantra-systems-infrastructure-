# Enquiry form delivery (optional).
# Create a free access key at https://web3forms.com using yantrasysteminfrastructure@gmail.com,
# then set it here (locally in .env, and in Vercel → Project → Settings → Environment Variables).
# When this is NOT set, the form validates input and hands the enquiry to WhatsApp / email instead
# of pretending it was submitted.
VITE_WEB3FORMS_ACCESS_KEY=

# Optional: allow visitors to attach a reference file (PDF, Word, PowerPoint, image; max 5 MB) to the
# enquiry. Web3Forms only accepts attachments on its paid plan, so leave this unset on the free plan:
# visitors are then asked to share files on WhatsApp / email instead.
VITE_WEB3FORMS_ATTACHMENTS=
